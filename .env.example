# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://vposmagsttyfngdgetxl.supabase.co
# Chave pública (publishable): pode ir para o navegador; a RLS protege os dados
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_MeZCXM1Bs7BweInLT8zW_g_Ra4JR7yD
# O painel (Next.js) NÃO usa a chave de serviço. Ela só existe dentro das Edge Functions.

# Modo offline de desenvolvimento (telas com dados fictícios, só em `next dev`)
# PAINEL_OFFLINE=1
# NEXT_PUBLIC_PAINEL_OFFLINE=1

# ── Auth ──
# E-mail e senha (Supabase Auth). Contas criadas pelo admin em Authentication → Users.
# No projeto: desligar "Allow new users to sign up".

# ── Ingestão ──
INGEST_WEBHOOK_SECRET=              # assinatura do webhook (Netlify JWS ou HMAC próprio)
