# ── Site público (muda de hospedagem/domínio: NUNCA fixar no código) ──
SITE_URL=https://tubular-smakager-280471.netlify.app
# Origens que podem chamar a ingestão (CSV). Adicione o domínio novo aqui na migração.
ALLOWED_ORIGINS=https://tubular-smakager-280471.netlify.app,http://localhost:3000
# URL pública deste painel (links em e-mails/WhatsApp)
PANEL_URL=http://localhost:3000

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor / Edge Functions. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ──
# E-mail e senha (Supabase Auth). Contas criadas pelo admin em Authentication → Users.
# No projeto: desligar "Allow new users to sign up".

# ── Ingestão ──
INGEST_WEBHOOK_SECRET=              # assinatura do webhook (Netlify JWS ou HMAC próprio)
IP_HASH_SALT=                       # opcional (padrão: chave de serviço)

# ── Integrações (Fase 1+) ──
RESEND_API_KEY=
EMAIL_FROM="Stark <contato@stark.dev.br>"   # (aceita também MAIL_FROM, nome usado pelo painel anterior)
EMAIL_REPLY_TO=                              # respostas do cliente vão para cá
WHATSAPP_PROVIDER=none              # none | cloud_api | zapi | evolution — ainda não contratado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEAM_GROUP_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Agenda (Fase 2 — Google Calendar ou Cal.com, a decidir)
